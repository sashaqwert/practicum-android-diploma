<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".search.ui.fragment.SearchFragment">

    <TextView
        android:id="@+id/search_text_view"
        style="@style/Text.Medium22"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginHorizontal="16dp"

        android:layout_marginVertical="19dp"
        android:text="@string/search"
        app:layout_constraintEnd_toStartOf="@id/filer_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/filer_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:stateListAnimator="@null"
        app:icon="@drawable/ic_filter_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/search_text_view"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/search_edit_text"
        style="@style/Text.Regular16"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="27dp"
        android:layout_marginBottom="11dp"
        android:background="@drawable/edit_text_background"
        android:drawableEnd="@drawable/ic_magnifier_17"
        android:drawablePadding="15dp"
        android:hint="@string/request_input"
        android:lines="1"
        android:paddingStart="16dp"
        android:paddingEnd="15dp"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textColorHint="@color/for_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_text_view" />

    <ImageView
        android:id="@+id/space_for_img_in_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/img_default_search_state_328"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
