<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="9dp">

    <ImageView
        android:id="@+id/image_recycler_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/shape_for_image_recycler_view_element"
        android:src="@drawable/img_empty_logo_48_xml"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/vacation_name"
        style="@style/Text.Medium22"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/image_recycler_view"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Андроид-разработчик" />

    <TextView
        android:id="@+id/industry"
        style="@style/Text.Regular16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/image_recycler_view"
        app:layout_constraintTop_toBottomOf="@id/vacation_name"
        tools:text="Андроид-разработчик" />

    <TextView
        android:id="@+id/salary"
        style="@style/Text.Regular16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/image_recycler_view"
        app:layout_constraintTop_toBottomOf="@id/industry"
        tools:text="Андроид-разработчик" />
</androidx.constraintlayout.widget.ConstraintLayout>
