<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/margin_16"
    android:orientation="vertical"
    tools:context=".developers.ui.fragment.DevelopersFragment">

    <TextView
        style="@style/Text.Medium22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_19"
        android:text="@string/team" />

    <TextView
        style="@style/Text.Bold32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_24"
        android:text="@string/work" />

    <TextView
        style="@style/Text.Medium16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:text="@string/dev_name1" />

    <TextView
        style="@style/Text.Medium16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:text="@string/dev_name2" />

    <TextView
        style="@style/Text.Medium16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:text="@string/dev_name3" />

    <TextView
        style="@style/Text.Medium16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:text="@string/dev_name4" />
</LinearLayout>
