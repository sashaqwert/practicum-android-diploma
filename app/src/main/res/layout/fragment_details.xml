<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".details.ui.fragment.DetailsFragment"
    android:id="@+id/main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:contentInsetStartWithNavigation="@dimen/margin_4"
        app:titleTextAppearance="@style/Text.Medium22"
        app:navigationIconTint="?attr/colorOnPrimary"
        app:title="@string/vacancy"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/likeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_like"
        android:background="@null"
        android:layout_marginEnd="@dimen/margin_8"
        android:layout_marginStart="@dimen/margin_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/toolBar"
        app:layout_constraintBottom_toBottomOf="@id/toolBar"/>

    <ImageButton
        android:id="@+id/shareButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_share"
        android:background="@null"
        android:layout_marginEnd="@dimen/margin_8"
        app:layout_constraintEnd_toStartOf="@id/likeButton"
        app:layout_constraintTop_toTopOf="@id/toolBar"
        app:layout_constraintBottom_toBottomOf="@id/toolBar"/>

    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/toolBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/errorImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:src="@drawable/img_not_found"/>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Medium22"
            android:layout_marginTop="@dimen/margin_16"
            tools:text="Вакансия не найдена или удалена"/>
    </LinearLayout>

    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="@dimen/width_48"
        android:layout_height="@dimen/height_48"
        android:backgroundTint="@color/blue"
        android:src="@drawable/ic_loading_search_state_36"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolBar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/vacancyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolBar"
        tools:visibility="gone">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/startGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/margin_16"/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/endGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="@dimen/margin_16"/>

            <TextView
                android:id="@+id/vacancyName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16"
                style="@style/Text.Bold32"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                tools:text="Android-разработчик"/>

            <TextView
                android:id="@+id/salary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Medium22"
                android:layout_marginTop="@dimen/margin_4"
                app:layout_constraintTop_toBottomOf="@id/vacancyName"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                tools:text="от 100 000 ₽"/>


            <View
                android:id="@+id/employerContainer"
                android:layout_width="@dimen/height_0"
                android:layout_height="@dimen/margin_80"
                android:layout_marginTop="@dimen/margin_16"
                android:background="@drawable/employer_shape"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintTop_toBottomOf="@id/salary"/>

            <ImageView
                android:id="@+id/employerIcon"
                android:layout_width="@dimen/width_48"
                android:layout_height="@dimen/height_48"
                app:layout_constraintDimensionRatio="h,1:1"
                android:layout_marginStart="@dimen/margin_16"
                android:background="@drawable/rounded_12"
                app:layout_constraintTop_toTopOf="@id/employerContainer"
                app:layout_constraintBottom_toBottomOf="@id/employerContainer"
                app:layout_constraintStart_toStartOf="@id/employerContainer"
                tools:src="@drawable/img_empty_logo_48_xml"/>


            <TextView
                android:id="@+id/employerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Medium22"
                android:layout_marginStart="@dimen/margin_8"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/employerIcon"
                app:layout_constraintTop_toTopOf="@id/employerIcon"
                app:layout_constraintBottom_toTopOf="@id/employerLocation"
                app:layout_constraintEnd_toEndOf="@id/employerContainer"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Еда"/>

            <TextView
                android:id="@+id/employerLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Regular16"
                android:layout_marginStart="@dimen/margin_8"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/employerIcon"
                app:layout_constraintTop_toBottomOf="@id/employerName"
                app:layout_constraintBottom_toBottomOf="@id/employerIcon"
                app:layout_constraintEnd_toEndOf="@id/employerContainer"
                tools:text="Москва"/>

            <TextView
                android:id="@+id/experienceKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Medium16"
                android:text="@string/required_experience"
                android:layout_marginTop="@dimen/margin_24"
                app:layout_constraintTop_toBottomOf="@id/employerContainer"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline" />

            <TextView
                android:id="@+id/experienceValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Regular16"
                android:layout_marginTop="@dimen/margin_4"
                app:layout_constraintTop_toBottomOf="@id/experienceKey"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                tools:text="От 1 года до 3 лет"/>

            <TextView
                android:id="@+id/conditions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Regular16"
                android:layout_marginTop="@dimen/margin_8"
                app:layout_constraintTop_toBottomOf="@id/experienceValue"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                tools:text="Полная занятость, Удаленная работа"/>

            <TextView
                android:id="@+id/description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Regular16"
                android:gravity="start"
                android:layout_marginTop="@dimen/margin_32"
                app:layout_constraintTop_toBottomOf="@id/conditions"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                tools:text="Описание вакансии\nОбязанности\nРазрабатывать новую функциональность приложения
            Помогать с интеграцией нашего SDK в другие приложения
            Проектировать большие новые модули
            Писать UI- и unit-тесты
            Следить за работоспособностью сервиса и устранять технический долг"/>

            <TextView
                android:id="@+id/skillsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Medium22"
                android:gravity="start"
                android:text="@string/skills"
                android:layout_marginTop="@dimen/margin_24"
                app:layout_constraintTop_toBottomOf="@id/description"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                tools:text="Ключевые навыки"/>

            <TextView
                android:id="@+id/skillsList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/Text.Regular16"
                android:gravity="start"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_marginBottom="@dimen/margin_24"
                app:layout_constraintTop_toBottomOf="@id/skillsTitle"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                tools:text="Ключевые навыки"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
