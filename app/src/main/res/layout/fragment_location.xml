<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    tools:context=".filter.ui.fragments.LocationFragment">

    <ImageButton
        android:id="@+id/from_work_place"
        android:layout_width="@dimen/width_48"
        android:layout_height="@dimen/height_48"
        android:layout_marginHorizontal="@dimen/margin_4"
        android:layout_marginVertical="@dimen/margin_8"
        android:background="@null"
        android:backgroundTint="?attr/colorPrimary"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/workplace_tool_bar"
        style="@style/Text.Medium22"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_64"
        android:gravity="center_vertical"
        android:text="@string/work_place_chose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/from_work_place"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/chosen_country_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_60"
        android:layout_marginTop="@dimen/margin_16"
        android:hint="@string/country"
        app:boxBackgroundMode="filled"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconDrawable="@drawable/ic_chose_8"
        app:endIconMode="custom"
        app:endIconTint="?attr/colorOnPrimary"
        app:hintTextColor="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/workplace_tool_bar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/chosen_country"
            style="@style/Text.Regular16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="?attr/colorPrimary"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawablePadding="@dimen/margin_4"
            android:focusable="false"
            android:gravity="center_vertical"
            android:inputType="none"
            android:saveEnabled="false"
            android:paddingStart="@dimen/margin_16"
            android:textColor="?attr/colorOnPrimary"
            app:drawableEndCompat="@drawable/ic_chose_8"
            tools:text="@string/country" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/country_clear"
        android:layout_width="@dimen/width_48"
        android:layout_height="@dimen/height_48"
        android:layout_marginEnd="@dimen/margin_4"
        android:backgroundTint="?attr/colorPrimary"
        android:src="@drawable/ic_clear_14"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/chosen_country_layout"
        app:layout_constraintEnd_toEndOf="@id/chosen_country_layout"
        app:layout_constraintTop_toTopOf="@id/chosen_country_layout" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/chosen_region_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_60"
        android:hint="@string/region"
        app:boxBackgroundMode="filled"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconDrawable="@drawable/ic_chose_8"
        app:endIconMode="custom"
        app:endIconTint="?attr/colorOnPrimary"
        app:hintTextColor="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chosen_country_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/chosen_region"
            style="@style/Text.Regular16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="?attr/colorPrimary"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawablePadding="@dimen/margin_4"
            android:focusable="false"
            android:gravity="center_vertical"
            android:inputType="none"
            android:saveEnabled="false"
            android:paddingStart="@dimen/margin_16"
            android:textColor="?attr/colorOnPrimary"
            app:drawableEndCompat="@drawable/ic_chose_8"
            tools:text="@string/region" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/region_clear"
        android:layout_width="@dimen/width_48"
        android:layout_height="@dimen/height_48"
        android:layout_marginEnd="@dimen/margin_4"
        android:backgroundTint="?attr/colorPrimary"
        android:src="@drawable/ic_clear_14"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/chosen_region_layout"
        app:layout_constraintEnd_toEndOf="@id/chosen_region_layout"
        app:layout_constraintTop_toTopOf="@id/chosen_region_layout" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/workplace_chose_button"
        style="@style/Text.Medium16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_17"
        android:layout_marginBottom="@dimen/margin_24"
        android:backgroundTint="@color/blue"
        android:paddingVertical="20dp"
        android:stateListAnimator="@null"
        android:text="@string/chose"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:visibility="gone"
        app:cornerRadius="@dimen/corners_12"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
