<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="ru.practicum.android.diploma.Search.ui.fragment.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
        <action
            android:id="@+id/action_searchFragment_to_filterFragment"
            app:destination="@id/filterFragment" />
    </fragment>
    <fragment
        android:id="@+id/favoriteFragmant"
        android:name="ru.practicum.android.diploma.Favorite.ui.fragment.FavoriteFragmant"
        android:label="fragment_favorite"
        tools:layout="@layout/fragment_favorite" >
        <action
            android:id="@+id/action_favoriteFragmant_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/developersFragment"
        android:name="ru.practicum.android.diploma.Developers.ui.fragment.DevelopersFragment"
        android:label="fragment_developers"
        tools:layout="@layout/fragment_developers" />
    <fragment
        android:id="@+id/detailsFragment"
        android:name="ru.practicum.android.diploma.Details.ui.fragment.DetailsFragment"
        android:label="fragment_details"
        tools:layout="@layout/fragment_details" />
    <fragment
        android:id="@+id/filterFragment"
        android:name="ru.practicum.android.diploma.Filter.ui.fragments.FilterFragment"
        android:label="fragment_filter"
        tools:layout="@layout/fragment_filter" >
        <action
            android:id="@+id/action_filterFragment_to_locationFragmengt"
            app:destination="@id/locationFragmengt" />
        <action
            android:id="@+id/action_filterFragment_to_otraslFragment"
            app:destination="@id/otraslFragment" />
    </fragment>
    <fragment
        android:id="@+id/locationFragmengt"
        android:name="ru.practicum.android.diploma.Filter.ui.fragments.LocationFragment"
        android:label="fragment_location"
        tools:layout="@layout/fragment_location" >
        <action
            android:id="@+id/action_locationFragmengt_to_countryFragment"
            app:destination="@id/countryFragment" />
        <action
            android:id="@+id/action_locationFragmengt_to_regionFragment"
            app:destination="@id/regionFragment" />
    </fragment>
    <fragment
        android:id="@+id/regionFragment"
        android:name="ru.practicum.android.diploma.Filter.ui.fragments.RegionFragment"
        android:label="fragment_region"
        tools:layout="@layout/fragment_region" />
    <fragment
        android:id="@+id/countryFragment"
        android:name="ru.practicum.android.diploma.Filter.ui.fragments.CountryFragment"
        android:label="fragment_country"
        tools:layout="@layout/fragment_country" />
    <fragment
        android:id="@+id/otraslFragment"
        android:name="ru.practicum.android.diploma.Filter.ui.fragments.IndustriesFragment"
        android:label="fragment_otrasl"
        tools:layout="@layout/fragment_industries" />
</navigation>
