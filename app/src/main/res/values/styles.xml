<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text">
        <item name="android:color">@color/black</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Text.Bold32">
        <item name="android:fontFamily">@font/ys_display_bold</item>
        <item name="android:fontWeight">700</item>
        <item name="android:textSize">@dimen/text_32</item>
        <item name="lineHeight">@dimen/text_36</item>
    </style>

    <style name="Text.Medium22">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:fontWeight">500</item>
        <item name="android:textSize">@dimen/text_22</item>
        <item name="lineHeight">@dimen/text_26</item>
    </style>

    <style name="Text.Medium16">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:fontWeight">500</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="lineHeight">@dimen/text_19</item>
    </style>

    <style name="Text.Regular16">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="lineHeight">@dimen/text_19</item>
    </style>

    <style name="Text.Regular12">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="lineHeight">@dimen/text_16</item>
